# ==============================================================================
# AGROSENSE AI - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# COPIA ESTE ARCHIVO COMO '.env' EN TU MÁQUINA LOCAL Y COMPLETA LOS VALORES.
# NUNCA SUBAS EL ARCHIVO '.env' A GITHUB.
# ==============================================================================

# Entorno de ejecución: development | production | testing
ENVIRONMENT=development

# Puerto del servidor backend
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# PROVEEDOR DE LLM (DeepSeek / OpenAI / Azure OpenAI / Gemini)
# ------------------------------------------------------------------------------
# API Key del modelo de lenguaje
LLM_API_KEY=tu_api_key_aqui

# Nombre del modelo a utilizar (ej: gpt-4o-mini, deepseek-chat, gemini-1.5-flash)
LLM_MODEL_NAME=deepseek-chat

# Endpoint si usas Azure OpenAI (opcional)
AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/

# ------------------------------------------------------------------------------
# TOKEN DE SEGURIDAD PARA COMUNICACIÓN JEV & DISPOSITIVOS
# ------------------------------------------------------------------------------
# Token secreto para validar que la telemetría proviene de tus ESP32 autorizados
JEV_DEVICE_AUTH_TOKEN=agrosense_secret_token_cambiar_en_produccion

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS
# ------------------------------------------------------------------------------
# En local usa SQLite embebido; en Azure puede apuntar a Azure PostgreSQL
DATABASE_URL=sqlite:///./app/agrosense.db
