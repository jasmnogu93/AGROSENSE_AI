<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/asai_surface"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/asai_primary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:subtitle="@string/service_subtitle"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="#C8E6C9" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ======================================================= -->
                <!-- SECCIÓN 1: ESTADO Y ALERTAS (RF4, RF7)                  -->
                <!-- ======================================================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_section_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/asai_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/asai_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sec1_title"
                            android:textColor="@color/asai_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sec1_profile_summary"
                            android:textColor="@color/asai_text_secondary"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/asai_divider" />

                        <!-- Indicadores Térmico y Humedad -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Tarjeta Temperatura -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_temp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/asai_surface"
                                app:cardCornerRadius="10dp"
                                app:strokeColor="@color/asai_divider"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:contentDescription="@string/label_temperature"
                                        android:src="@drawable/ic_thermostat"
                                        app:tint="@color/asai_primary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/label_temperature"
                                        android:textColor="@color/asai_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tv_temperature"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="--.- °C"
                                        android:textColor="@color/asai_text_primary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_temp_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_badge_optimal"
                                        android:text="Óptimo (18–24 °C)"
                                        android:textColor="@color/asai_optimal"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Tarjeta Humedad Relativa -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/card_hum"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/asai_surface"
                                app:cardCornerRadius="10dp"
                                app:strokeColor="@color/asai_divider"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:contentDescription="@string/label_humidity"
                                        android:src="@drawable/ic_water_drop"
                                        app:tint="@color/asai_primary" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="@string/label_humidity"
                                        android:textColor="@color/asai_text_secondary"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/tv_humidity"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="--.- %"
                                        android:textColor="@color/asai_text_primary"
                                        android:textSize="22sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_hum_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:background="@drawable/bg_badge_optimal"
                                        android:text="Óptimo (75–85%)"
                                        android:textColor="@color/asai_optimal"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Sub-info: Sustrato, Estado de Módulo y Timestamp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_soil_humidity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sustrato: --.- %"
                                android:textColor="@color/asai_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tv_module_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Módulo: ÓPTIMO"
                                android:textColor="@color/asai_optimal"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_last_updated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Última actualización: --"
                            android:textColor="@color/asai_text_secondary"
                            android:textSize="11sp" />

                        <!-- Contenedor dinámico de alertas visuales (RF4, RF7) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Alertas Sanitarias y Ambientales:"
                            android:textColor="@color/asai_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/ll_alerts_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_no_alerts"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_optimal"
                                android:padding="10dp"
                                android:text="@string/no_alerts_message"
                                android:textColor="@color/asai_optimal"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="@color/asai_primary"
                            android:text="@string/btn_refresh"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_refresh"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================================= -->
                <!-- SECCIÓN 2: RIEGO SEMANAL Y NOTIFICACIÓN (RF1, RF2)      -->
                <!-- ======================================================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_section_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/asai_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/asai_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sec2_title"
                            android:textColor="@color/asai_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <!-- Banner de Notificación de Riego (RF2) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_notification_banner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="12dp"
                            app:cardBackgroundColor="@color/asai_banner_bg"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="@color/asai_banner_stroke"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="22dp"
                                        android:layout_height="22dp"
                                        android:contentDescription="@string/notification_banner_title"
                                        android:src="@drawable/ic_notifications"
                                        app:tint="@color/asai_banner_text" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:layout_weight="1"
                                        android:text="@string/notification_banner_title"
                                        android:textColor="@color/asai_banner_text"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_notification_badge"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_badge_optimal"
                                        android:text="PRÓXIMO"
                                        android:textColor="@color/asai_optimal"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_notification_message"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="Consultando próxima cita de riego..."
                                    android:textColor="@color/asai_banner_text"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/days_selector_label"
                            android:textColor="@color/asai_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Selección exacta de días: "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="4dp"
                            app:singleSelection="false">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_lun"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_lun" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_mar"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_mar" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_mie"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_mie" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_jue"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_jue" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_vie"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_vie" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_sab"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_sab" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_dom"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checkable="true"
                                android:text="@string/day_dom" />
                        </com.google.android.material.chip.ChipGroup>

                        <!-- Campos Hora y Duración -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_irrigation_time"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:hint="@string/hint_irrigation_time"
                                app:helperText="Formato HH:mm">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_irrigation_time"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:inputType="none"
                                    android:text="08:30" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_duration_minutes"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:hint="@string/hint_duration_minutes"
                                app:helperText="Rango: 1 - 120">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_duration_minutes"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:text="20" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save_schedule"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:backgroundTint="@color/asai_primary"
                            android:text="@string/btn_save_schedule"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_save"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ======================================================= -->
                <!-- SECCIÓN 3: TELEMETRÍA E HISTORIAL (RF3, RF5, RF6)       -->
                <!-- ======================================================= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_section_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/asai_card_bg"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/asai_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sec3_title"
                            android:textColor="@color/asai_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sec3_subtitle"
                            android:textColor="@color/asai_text_secondary"
                            android:textSize="12sp" />

                        <!-- Formulario de Telemetría -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_telemetry_temp"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:hint="Temp (°C)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_telemetry_temp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:text="21.5" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_telemetry_hum"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:hint="Hum (%)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_telemetry_hum"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:text="80.0" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/til_telemetry_soil"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:hint="Sustrato (%)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_telemetry_soil"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="numberDecimal"
                                    android:text="68.0" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_send_telemetry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/asai_primary"
                            android:text="@string/btn_send_telemetry"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_send"
                            app:iconGravity="textStart"
                            app:iconTint="@color/white" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/asai_divider" />

                        <!-- Historial de Condiciones Ambientales (RF5) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/history_header"
                            android:textColor="@color/asai_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_history"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tv_empty_history"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="@string/history_empty"
                            android:textColor="@color/asai_text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
